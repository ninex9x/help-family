{
  "name": "help-family",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vinext build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "android:apk": "npm run build:mobile && cd android && gradlew.bat assembleDebug",
    "start": "npm run dev",
    "test": "npm run build && npm run build:demo && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/health-state.test.mjs tests/server-vault.test.mjs tests/demo-api.test.mjs tests/static-demo.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern android/**/build --ignore-pattern android/app/src/main/assets/www"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/material-symbols-outlined": "5.3.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/workers-types": "5.20260915.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.132.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260915.1": true,
    "unrs-resolver@1.11.1": true
  }
}
