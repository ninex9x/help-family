{
  "name": "help-family",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node backend/server.js",
    "start": "node backend/server.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "migrate:legacy": "node scripts/migrate-legacy.js",
    "backup": "node scripts/backup.js",
    "format": "prettier --write frontend backend scripts tests docs README.md package.json vite.config.js playwright.config.js",
    "format:check": "prettier --check frontend backend scripts tests docs README.md package.json vite.config.js playwright.config.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/material-symbols-outlined": "5.3.5",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
